# Copie para .env e preencha.
PORT=3000
DATA_DIR=./data

# Senha do painel do dono (/admin). Use uma senha forte.
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório longo (ex.: gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Chaves das IAs (preencha só as que for usar)
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# FASHN: https://app.fashn.ai/api
FASHN_API_KEY=

# Em produção (HTTPS), deixe NODE_ENV=production para cookies seguros
NODE_ENV=development
